# Výchozí složka s hrami (absolutní nebo relativní k solo-rpg-be). Prohlížeč si může zvolit jinou –
# ta se uloží v localStorage a FE ji posílá s každým požadavkem (hlavička x-vault-path).
VAULT_PATH=../vault

# Port lokálního API serveru
PORT=3001

# --- Úložiště (v2) ---
# Postgres z docker-compose.yml v rootu monorepa (`docker compose up -d`)
DATABASE_URL=postgres://solo:solo@localhost:5432/solo_rpg
# Složka s lokálními daty mimo DB (assety: obrázky). Relativně k solo-rpg-be nebo absolutně.
DATA_DIR=../data

# --- AI vypravěč ---
# Provider: `openrouter` (výchozí) nebo `mistral` (přímo Mistral AI API). Použije se klíč a model daného providera.
AI_PROVIDER=openrouter

# OpenRouter – API klíč z https://openrouter.ai/keys; bez něj je AI vypnutá (při AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=
# Model (id z OpenRouter)
OPENROUTER_MODEL=mistralai/mistral-medium-3-5

# Mistral AI – API klíč z https://console.mistral.ai/api-keys; bez něj je AI vypnutá (při AI_PROVIDER=mistral)
MISTRAL_API_KEY=
# Model (id z Mistral AI, např. mistral-medium-latest, mistral-large-latest, mistral-small-latest)
MISTRAL_MODEL=mistral-medium-latest
# Soubor s výchozím promptem pro vedení scény (relativně k solo-rpg-be)
AI_PROMPT_PATH=prompts/scene-prompt.md
# Soubor s promptem pro AI shrnutí děje scény (tlačítko „Shrnout pomocí AI“ v dialogu scény)
AI_SUMMARY_PROMPT_PATH=prompts/scene-summary-prompt.md
# Soubor s promptem o kostkách / orákulu a herních pravidlech pod příběhem (připojuje se k AI požadavkům jen při zapnutém přepínači ve hře)
AI_RULES_PROMPT_PATH=prompts/rules-prompt.md
# Volitelně: limit tokenů odpovědi a teplota
AI_MAX_TOKENS=1500
AI_TEMPERATURE=0.9
# AI_DEBUG=1 vypíše do konzole BE celý odeslaný prompt (system + user) a surovou odpověď modelu
AI_DEBUG=0
