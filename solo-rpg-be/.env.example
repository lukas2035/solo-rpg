# Výchozí složka s hrami (absolutní nebo relativní k solo-rpg-be). Prohlížeč si může zvolit jinou –
# ta se uloží v localStorage a FE ji posílá s každým požadavkem (hlavička x-vault-path).
VAULT_PATH=../vault

# Port lokálního API serveru
PORT=3001

# --- AI vypravěč (OpenRouter) ---
# API klíč z https://openrouter.ai/keys – bez něj je AI vypnutá
OPENROUTER_API_KEY=
# Model (id z OpenRouter), výchozí Mistral Large 3
OPENROUTER_MODEL=mistralai/mistral-large-2512
# Soubor s výchozím promptem pro vedení scény (relativně k solo-rpg-be)
AI_PROMPT_PATH=prompts/scene-prompt.md
# Soubor s promptem pro AI shrnutí děje scény (tlačítko „Shrnout pomocí AI“ v dialogu scény)
AI_SUMMARY_PROMPT_PATH=prompts/scene-summary-prompt.md
# Soubor s promptem o kostkách / orákulu a herních pravidlech pod příběhem (připojuje se k AI požadavkům jen při zapnutém přepínači ve hře)
AI_RULES_PROMPT_PATH=prompts/rules-prompt.md
# Volitelně: limit tokenů odpovědi a teplota
AI_MAX_TOKENS=1500
AI_TEMPERATURE=0.9
# AI_DEBUG=1 vypíše do konzole BE celý odeslaný prompt (system + user) a surovou odpověď modelu
AI_DEBUG=0
