{
  "name": "solo-rpg-be",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "import:vault": "tsx --env-file-if-exists=.env scripts/import-vault.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "@solo-rpg/shared": "*",
    "archiver": "^8.0.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.3.2",
    "gray-matter": "^4.0.3",
    "nanoid": "^3.3.19",
    "pg": "^8.23.1",
    "pino-pretty": "^13.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.3",
    "typescript": "~6.0.2",
    "vitest": "^5.0.3"
  }
}
